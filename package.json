{
  "name": "petoskeystone",
  "version": "0.1.0",
  "description": "Procedurally generate Petoskey stone (Hexagonaria) images: stylized or photo-real, tileable, PNG/JPEG/JPEG XL/AVIF",
  "type": "module",
  "bin": {
    "petoskeystone": "src/cli.mts"
  },
  "scripts": {
    "start": "node src/cli.mts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.mts\"",
    "examples": "node scripts/examples.mts"
  },
  "engines": {
    "node": ">=23.6"
  },
  "author": "Edwin Gustafson <edwingustafson@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@jsquash/jxl": "^1.3.0",
    "@napi-rs/canvas": "^1.1.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
